{
  "name": "@aira-synapse/memgraphrag",
  "version": "0.6.0",
  "description": "Memory-based Multi-Agent System for Graph Retrieval-Augmented Generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "config",
    "scripts/graphdb-repository-authority.mjs"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && cp -r src/infrastructure/storage/migrations dist/infrastructure/storage/",
    "test": "vitest run",
    "test:ci": "node scripts/run-vitest-partitions.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "node scripts/run-vitest-partitions.mjs --coverage",
    "verify:production-runtime-anchor": "node scripts/production-runtime-anchor.mjs",
    "generate:bounded-domain-fixture": "npm run build && node scripts/generate-bounded-domain-fixture.mjs",
    "check:bounded-domain-fixture": "npm run build && node scripts/generate-bounded-domain-fixture.mjs --check",
    "generate:unicode16-lowercase": "node scripts/generate-unicode16-lowercase.mjs",
    "check:unicode16-lowercase": "node scripts/generate-unicode16-lowercase.mjs --check",
    "lint": "eslint src/ tests/",
    "bench": "vitest bench",
    "start:mcp": "node dist/interface/mcp/server.js",
    "start:cli": "node dist/interface/cli/index.js",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "commander": "^15.0.0",
    "neo4j-driver": "^6.1.0",
    "undici": "^8.10.0",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@ladybugdb/core": "^0.17.1"
  }
}
